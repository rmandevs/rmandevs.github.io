---
import '../styles/global.css';
import Doodle from '../components/Doodle.astro';
import PaperStack from '../components/PaperStack.astro';
import { site } from '../config';
interface Props { title?: string; description?: string; tab?: 'projects' | 'notebook'; bare?: boolean; }
const { title, description = site.description, tab, bare = false } = Astro.props;
// The ruler along the top of the mat: a number every five squares.
const ruler = Array.from({ length: 32 }, (_, i) => i * 5);
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} / ${site.handle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  { key: 'projects', href: '/#projects', label: 'projects' },
  { key: 'notebook', href: '/blog/', label: 'notebook' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Armando — Notebook" href="/rss.xml" />
    <link rel="preload" href="/fonts/Fraunces-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Caveat-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <!-- The shaky pen line used by every doodle. -->
    <svg class="defs" width="0" height="0" aria-hidden="true"><filter id="wobble" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="1" seed="4" /><feDisplacementMap in="SourceGraphic" scale="1.3" /></filter></svg>
    <div class="ruler" aria-hidden="true">{ruler.map(n => <span>{n}</span>)}</div>
    <svg class="mat-marks" viewBox="0 0 720 720" fill="none" stroke="currentColor" stroke-width="1.500" aria-hidden="true">
      <path d="M240 0A240 240 0 0 1 0 240M480 0A480 480 0 0 1 0 480M720 0A720 720 0 0 1 0 720" />
      <path d="M0 0l720 720M0 0l360 720M0 0l720 360" stroke-dasharray="7 9" />
    </svg>
    <div class="desk">
      <header class="topbar">
        <a class="home-mark" href="/" aria-label="Armando, home"><Doodle name="mark" size={34} /></a>
        <nav class="topnav" aria-label="Main">
          {links.map(link => <a href={link.href} aria-current={tab === link.key ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <button class="theme-toggle" hidden type="button" aria-label="Switch theme"><Doodle name="moon" size={26} class="icon-moon" /><Doodle name="sun" size={26} class="icon-sun" /></button>
      </header>
      <main id="main">{bare ? <slot /> : <PaperStack><slot /></PaperStack>}</main>
      <footer class="site-footer">
        <p class="footer-note">measured twice, shipped once</p>
        <nav aria-label="Elsewhere">
          <a href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
          {site.x && <a href={site.x}>X <span aria-hidden="true">↗</span></a>}
          <a href={site.lofisons}>lofisons <span aria-hidden="true">↗</span></a>
          <a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
        </nav>
      </footer>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      if (toggle) {
        const root = document.documentElement;
        const current = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const update = () => toggle.setAttribute('aria-label', `Switch to ${current() === 'light' ? 'night' : 'day'} paper`);
        toggle.hidden = false;
        update();
        toggle.addEventListener('click', () => {
          const next = current() === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          update();
        });
      }
    </script>
  </body>
</html>
