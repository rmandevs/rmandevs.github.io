---
import '../styles/global.css';
import { site } from '../config';
interface Props { title?: string; description?: string; home?: boolean; }
const { title, description = site.description, home = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} / ${site.handle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Armando — Notebook" href="/rss.xml" />
    <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="column">
      <header class="top">
        {home ? <h1 class="name">{site.name}</h1> : <a class="name" href="/">{site.name}</a>}
        <button class="theme-toggle" hidden type="button" aria-label="Switch theme"></button>
      </header>
      <main id="main"><slot /></main>
      <footer>
        <a href={site.github}>GitHub</a>
        {site.x && <a href={site.x}>X</a>}
        <a href={site.lofisons}>lofisons</a>
        <a href="/rss.xml">RSS</a>
      </footer>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      if (toggle) {
        const root = document.documentElement;
        const current = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const update = () => toggle.setAttribute('aria-label', `Switch to ${current() === 'light' ? 'dark' : 'light'} theme`);
        toggle.hidden = false;
        update();
        toggle.addEventListener('click', () => {
          const next = current() === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          update();
        });
      }
    </script>
  </body>
</html>
