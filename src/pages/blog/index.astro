---
import Layout from '../../layouts/Layout.astro';
import { getPosts, dateLabel } from '../../lib/content';
const posts = await getPosts();
---
<Layout title="Notebook">
  <div class="article-page">
    <a class="back-link" href="/">← Back home</a>
    <header class="article-header"><p class="eyebrow">Notes & experiments</p><h1>Notebook<span class="title-period">.</span></h1><p class="article-summary">Things I build, things I learn, and the occasional detour.</p></header>
    {posts.length ? <div class="note-list blog-list">{posts.map(post => <a class="note-card" href={`/blog/${post.id}/`}><div class="note-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span class="tag">{post.data.type}</span></div><h2>{post.data.title} <span aria-hidden="true">↗</span></h2><p>{post.data.summary}</p></a>)}</div> : <div class="notebook-empty"><span class="empty-glyph" aria-hidden="true">[ ... ]</span><h2>A little room for ideas.</h2><p>The first notes are on their way.</p></div>}
  </div>
</Layout>
