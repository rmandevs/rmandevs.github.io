---
import Layout from '../../layouts/Layout.astro';
import { getPosts, dateLabel } from '../../lib/content';
const posts = await getPosts();
---
<Layout title="Notebook">
  <div class="head"><h1>Notebook</h1><p class="muted">Random thoughts.</p></div>
  <section>
    {posts.length ? <ol class="rows notes">{posts.map(post => <li>
      <a href={`/blog/${post.id}/`}><time class="meta" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>{post.data.title}</span></a>
    </li>)}</ol> : <p class="muted">Nothing yet. The first notes are on their way.</p>}
  </section>
</Layout>
