---
import Layout from '../../layouts/Layout.astro';
import Doodle from '../../components/Doodle.astro';
import { getPosts, dateLabel } from '../../lib/content';
const posts = await getPosts();
---
<Layout title="Notebook" tab="notebook">
  <div class="sheet">
    <a class="hand back-link" href="/">← back home</a>
    <header class="sheet-header"><p class="hand eyebrow">notes &amp; experiments</p><h1>Notebook<span class="title-period">.</span></h1><p class="sheet-summary">random thoughts</p></header>
    {posts.length ? <ol class="ruled">{posts.map(post => <li>
      <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
      <a href={`/blog/${post.id}/`}><h2>{post.data.title}</h2><p>{post.data.summary}</p><span class="tag">{post.data.type}</span></a>
    </li>)}</ol> : <div class="empty"><div class="sticky"><h2>A little room for ideas.</h2><p>The first notes are on their way.</p></div><Doodle name="pencil" size={76} /></div>}
  </div>
</Layout>
