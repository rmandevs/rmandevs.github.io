---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPosts, dateLabel } from '../../lib/content';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={post.data.title} description={post.data.summary}>
  <article class="article-page">
    <a class="back-link" href="/blog/">← Back to notebook</a>
    <header class="article-header"><p class="eyebrow">{post.data.type} · <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time></p><h1>{post.data.title}</h1><p class="article-summary">{post.data.summary}</p><div class="tags">{post.data.tags.map(tag => <span class="tag">{tag}</span>)}</div></header>
    <div class="prose"><Content /></div>
    {post.data.updated && <p class="updated-date">Updated {dateLabel(post.data.updated)}</p>}
  </article>
</Layout>
