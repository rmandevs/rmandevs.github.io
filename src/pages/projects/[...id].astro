---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getProjects, dateLabel } from '../../lib/content';
export async function getStaticPaths() {
  return (await getProjects()).map(project => ({ params: { id: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const host = (url: string) => new URL(url).hostname + new URL(url).pathname.replace(/\/$/, '');
---
<Layout title={data.title} description={data.summary}>
  <article>
    <header class="head">
      <h1>{data.title}</h1>
      <p class="muted">{data.summary}</p>
      <p class="facts">{data.category} · {data.language} · {data.license} · <time datetime={data.date.toISOString()}>{dateLabel(data.date)}</time></p>
    </header>
    {data.image && <figure class="shot"><img src={data.image} alt={data.imageAlt ?? ''} width={data.imageWidth} height={data.imageHeight} loading="lazy" decoding="async" />{data.imageCaption && <figcaption>{data.imageCaption}</figcaption>}</figure>}
    <div class="prose"><Content /></div>
    <p class="links">
      {data.website && <a href={data.website}>{host(data.website)} ↗</a>}
      {data.repo && <a href={`https://github.com/${data.repo}`}>GitHub ↗</a>}
      <a class="back" href="/">← Back</a>
    </p>
  </article>
</Layout>
