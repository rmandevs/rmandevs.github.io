---
import Layout from '../layouts/Layout.astro';
import Doodle from '../components/Doodle.astro';
import DeskScene from '../components/DeskScene.astro';
import { site } from '../config';
import { getProjects, getPosts, dateLabel } from '../lib/content';
const projects = await getProjects();
const posts = await getPosts();
const categoryLabels: Record<string, string> = { Tool: 'Tools', Theme: 'Themes', Layout: 'Layouts', 'Agent skill': 'Skills', 'Design system': 'Design', Studio: 'Studio' };
const categories = [...new Set(projects.map(project => project.data.category))];
const filters = [{ key: 'all', name: 'All' }, ...categories.map(key => ({ key, name: categoryLabels[key] ?? key }))];
---
<Layout>
  <section class="hero" aria-labelledby="name">
    <div class="hero-text">
      <p class="hand hero-hi">hi, I'm</p>
      <h1 id="name">Armando<span class="title-period">.</span>
        <svg class="scribble doodle" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9c34-7 62 5 96-1s66-6 100 0 60 3 98-3" /></svg>
      </h1>
      <p class="hero-role">Independent developer<br />&amp; curious builder</p>
      <p class="hero-line">I make small tools<br />with a bit of <mark>personality</mark></p>
      <a class="handle" href={site.github}>{site.handle} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-art">
      <DeskScene />
      <p class="hand art-note" aria-hidden="true">my desk, more or less</p>
    </div>
  </section>

  <section id="projects" class="block" aria-labelledby="projects-title">
    <div class="block-head">
      <h2 id="projects-title">Projects</h2>
      <p class="hand side-note"><Doodle name="arrow" size={30} />things I made</p>
    </div>
    <div class="filter-bar" role="group" aria-label="Filter projects" hidden>
      {filters.map(filter => <button type="button" data-filter={filter.key} aria-pressed={filter.key === 'all'}>{filter.name}</button>)}
      <span class="filter-count" aria-live="polite">{projects.length} projects</span>
    </div>
    <ul class="card-grid">
      {projects.map(project => <li data-category={project.data.category}>
        <a class="card" href={`/projects/${project.id}/`}>
          <span class="tape" aria-hidden="true"></span>
          <div class="card-top"><span class="hand card-kind">{project.data.category}</span><Doodle name={project.id} size={58} /></div>
          <h3>{project.data.title}</h3>
          <p>{project.data.summary}</p>
          <div class="card-meta"><span>{project.data.language}</span><span>{project.data.license}</span><span class="hand card-open">open <span aria-hidden="true">→</span></span></div>
        </a>
      </li>)}
    </ul>
    <a class="hand more-link" href={site.github}>all repositories <span aria-hidden="true">↗</span></a>
  </section>

  <section id="notebook" class="block" aria-labelledby="notebook-title">
    <div class="block-head">
      <h2 id="notebook-title">Notebook</h2>
      <p class="hand side-note"><Doodle name="arrow" size={30} />random thoughts</p>
    </div>
    {posts.length ? <ol class="ruled">{posts.slice(0, 4).map(post => <li>
      <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
      <a href={`/blog/${post.id}/`}><h3>{post.data.title}</h3><p>{post.data.summary}</p><span class="tag">{post.data.type}</span></a>
    </li>)}</ol> : <div class="empty"><div class="sticky"><h3>A little room for ideas.</h3><p>The first notes are on their way.</p></div><Doodle name="pencil" size={76} /></div>}
    <a class="hand more-link" href="/blog/">open the notebook <span aria-hidden="true">→</span></a>
  </section>

  <section id="about" class="block" aria-labelledby="about-title">
    <div class="block-head">
      <h2 id="about-title">About</h2>
      <p class="hand side-note"><Doodle name="arrow" size={30} />the person behind the projects</p>
    </div>
    <div class="about-grid">
      <p class="about-lead">I build small tools, agent skills and design systems, and I like giving them a bit of <mark>personality.</mark></p>
      <div class="about-detail">
        <p>Creator of <a href="https://usepegboard.dev">Pegboard <span aria-hidden="true">↗</span></a>.</p>
        <p>Founder of <a href={site.lofisons}>lofisons <span aria-hidden="true">↗</span></a>.</p>
        <p>This is my little corner of the internet: a place for useful experiments and notes along the way.</p>
        <a class="hand more-link" href={site.github}>find me on GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Layout>
<script>
  const filters = document.querySelector<HTMLElement>('.filter-bar');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLLIElement>('.card-grid > li');
  const count = document.querySelector('.filter-count');
  if (filters) filters.hidden = false;
  buttons.forEach(button => button.addEventListener('click', () => {
    const category = button.dataset.filter;
    buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
    let visible = 0;
    rows.forEach(row => { row.hidden = category !== 'all' && row.dataset.category !== category; if (!row.hidden) visible++; });
    if (count) count.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
  }));
</script>
