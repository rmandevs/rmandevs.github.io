---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
import { getProjects, getPosts, dateLabel } from '../lib/content';
const projects = await getProjects();
const posts = await getPosts();
---
<Layout home>
  <p class="muted">Independent developer &amp; curious builder</p>
  <p class="intro">I build small tools, agent stuff and music products, and I like giving them a bit of <span class="personality">personality</span>. Creator of <a href="https://usepegboard.dev">Pegboard</a> and founder of <a href={site.lofisons}>lofisons</a>.</p>

  <section id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title" class="label">Projects</h2>
    <ul class="rows">
      {projects.map(project => <li>
        <a href={`/projects/${project.id}/`}><span>{project.data.title}</span><span class="what">{project.data.summary}</span><span class="meta">{project.data.category}</span></a>
      </li>)}
    </ul>
    <a class="more" href={site.github}>All repositories ↗</a>
  </section>

  <section id="notebook" aria-labelledby="notebook-title">
    <h2 id="notebook-title" class="label">Notebook</h2>
    {posts.length ? <><ol class="rows notes">{posts.slice(0, 5).map(post => <li>
      <a href={`/blog/${post.id}/`}><time class="meta" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>{post.data.title}</span></a>
    </li>)}</ol><a class="more" href="/blog/">All notes →</a></> : <p class="muted">Nothing yet. The first notes are on their way.</p>}
  </section>
</Layout>
