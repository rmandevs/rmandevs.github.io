---
// A sheet of paper on top of two others, held by a paper clip and a binder clip.
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<div class:list={['stack', className]}>
  <svg class="clip" viewBox="0 0 34 84" fill="none" stroke-linecap="round" aria-hidden="true">
    <path d="M9 22v42a8.500 8.500 0 0 0 17 0V14a11 11 0 0 0-22 0v52" stroke="#6f7478" stroke-width="4" />
    <path d="M9 22v42a8.500 8.500 0 0 0 17 0V14a11 11 0 0 0-22 0v52" stroke="#d5d9dc" stroke-width="2.200" />
  </svg>
  <svg class="binder" viewBox="0 0 96 62" fill="none" aria-hidden="true">
    <path d="M40 22h34a9 9 0 0 1 0 18H40" stroke="#6f7478" stroke-width="4.500" />
    <path d="M40 22h34a9 9 0 0 1 0 18H40" stroke="#dfe3e6" stroke-width="2.400" />
    <path d="M6 4h30q8 0 8 8v38q0 8-8 8H6z" fill="#1d1a18" />
    <path d="M12 4v54" stroke="#3a3531" stroke-width="2" />
    <path d="M36 14v34" stroke="#3a3531" stroke-width="2" />
  </svg>
  <div class="paper"><slot /></div>
</div>
