---
// Hand-drawn line doodles. Plain shapes; the #wobble filter in Layout.astro
// gives them the shaky pen line. Decorative only, so always aria-hidden.
export type DoodleName =
  | 'pegboard' | 'lofisons' | 'comfytosh' | 'lazy-c7n' | 'mootion' | 'page'
  | 'pencil' | 'clip' | 'ring' | 'star' | 'sun' | 'moon' | 'arrow' | 'mark';
interface Props { name: string; size?: number; class?: string; }
const { name, size = 64, class: className } = Astro.props;
const known = ['pegboard', 'lofisons', 'comfytosh', 'lazy-c7n', 'mootion', 'pencil', 'clip', 'ring', 'star', 'sun', 'moon', 'arrow', 'mark'];
const doodle = known.includes(name) ? name : 'page';
---
<svg class:list={['doodle', className]} width={size} height={size} viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {doodle === 'pegboard' && <>
    <rect x="13" y="13" width="74" height="74" rx="9" />
    <g fill="currentColor" stroke="none"><circle cx="30" cy="30" r="2.2" /><circle cx="50" cy="30" r="2.2" /><circle cx="70" cy="30" r="2.2" /><circle cx="30" cy="50" r="2.2" /><circle cx="70" cy="50" r="2.2" /><circle cx="30" cy="70" r="2.2" /><circle cx="70" cy="70" r="2.2" /></g>
    <path d="M30 30v9q0 6 6 6" />
    <path d="M50 30v13" /><circle cx="50" cy="50" r="7" /><path d="M50 57v17M50 65h6M50 73h6" />
    <path d="M70 30v8l-5 9h10l-5-9" />
  </>}
  {doodle === 'lofisons' && <>
    <rect x="9" y="23" width="82" height="54" rx="6" />
    <rect x="20" y="32" width="60" height="25" rx="3" />
    <circle cx="36" cy="44.5" r="6" /><circle cx="64" cy="44.5" r="6" /><path d="M43 44.5h14" />
    <path d="M27 77l5-12h36l5 12" />
  </>}
  {doodle === 'comfytosh' && <>
    <path d="M25 10h50q6 0 6 6v60q0 6-6 6H25q-6 0-6-6V16q0-6 6-6z" />
    <rect x="28" y="20" width="44" height="34" rx="4" />
    <path d="M36 31l6 5-6 5M46 43h10" />
    <path d="M54 67h16" /><circle cx="31" cy="67" r="2" fill="currentColor" stroke="none" />
    <path d="M27 82v7h46v-7" />
  </>}
  {doodle === 'lazy-c7n' && <>
    <path d="M29 72q-17 0-17-15 0-13 14-15 4-17 22-17 16 0 21 15 19 0 19 16 0 16-17 16z" />
    <path d="M38 50l8 6-8 6M52 63h12" />
  </>}
  {doodle === 'mootion' && <>
    <rect x="11" y="17" width="78" height="66" rx="6" />
    <path d="M36 17v66" />
    <path d="M19 31h10M19 41h10M19 51h10" />
    <rect x="45" y="29" width="9" height="9" rx="2" />
    <path d="M45 48h28M45 58h34M45 68h22" />
  </>}
  {doodle === 'page' && <>
    <path d="M24 10h38l16 16v62H24z" /><path d="M62 10v16h16M34 42h32M34 54h32M34 66h20" />
  </>}
  {doodle === 'pencil' && <>
    <path d="M16 84l7-23 42-42 16 16-42 42z" /><path d="M23 61l16 16M57 27l16 16M16 84l8-2" />
  </>}
  {doodle === 'clip' && <path d="M34 22v48a13 13 0 0 0 26 0V28a9 9 0 0 0-18 0v40a4.500 4.500 0 0 0 9 0V34" />}
  {doodle === 'ring' && <>
    <path d="M50 10a40 40 0 1 1-28 12" /><path d="M50 22a28 28 0 1 0 20 8" opacity=".6" />
  </>}
  {doodle === 'star' && <path d="M50 12l8 28 28 10-28 10-8 28-8-28-28-10 28-10z" />}
  {doodle === 'sun' && <>
    <circle cx="50" cy="50" r="17" /><path d="M50 12v10M50 78v10M12 50h10M78 50h10M23 23l7 7M70 70l7 7M23 77l7-7M70 30l7-7" />
  </>}
  {doodle === 'moon' && <>
    <path d="M70 62a30 30 0 1 1-32-44 24 24 0 0 0 32 44z" />
  </>}
  {doodle === 'arrow' && <path d="M12 30q30-18 62 26M74 56l-3-20M74 56l-20-2" />}
  {doodle === 'mark' && <>
    <rect x="12" y="12" width="76" height="76" rx="18" /><path d="M58 44v22M58 55a11 11 0 1 1 0-1" /><circle cx="72" cy="65" r="3" fill="currentColor" stroke="none" />
  </>}
</svg>
